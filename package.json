{
  "name": "depviz",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive, collapsible dependency graph viewer that runs entirely in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
